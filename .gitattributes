# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Left out of the Composer dist. docs/, llms.txt and resources/ ship: llms.txt and
# the Boost skill point at docs/, and javaabu/manifest serves resources/js.
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.editorconfig      export-ignore
/.github            export-ignore
/phpunit.xml.dist   export-ignore
/pint.json          export-ignore
/tests              export-ignore
/AGENTS.md          export-ignore
/CLAUDE.md          export-ignore
/package.json       export-ignore
/pnpm-lock.yaml     export-ignore
/tsconfig.json      export-ignore
/vitest.config.ts   export-ignore
